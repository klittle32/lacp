{
  "name": "@kylelittle/lacp",
  "version": "0.2.1",
  "description": "An Agent Client Protocol (ACP) server for Letta Code, written in Effect",
  "keywords": [
    "acp",
    "agent-client-protocol",
    "letta",
    "letta-code",
    "effect",
    "zed"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klittle32/lacp.git"
  },
  "license": "MIT",
  "author": "Kyle Little <klittle32@gmail.com>",
  "type": "module",
  "bin": {
    "lacp": "dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "check": "tsc -p tsconfig.json",
    "build": "node scripts/build.ts",
    "prepublishOnly": "npm run build",
    "dev": "node src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint && dprint check && node scripts/check-suppressions.ts",
    "lint-fix": "oxlint --fix && dprint fmt",
    "format": "dprint fmt",
    "diagnostics": "effect-tsgo diagnostics --project tsconfig.json",
    "verify": "npm run check && npm run lint && npm test && npm run build",
    "smoke:t3": "node scripts/t3-smoke.ts"
  },
  "devDependencies": {
    "@dprint/json": "0.26.0",
    "@dprint/markdown": "0.29.0",
    "@dprint/typescript": "0.100.0",
    "@effect/platform-node": "4.1.4",
    "@effect/tsgo": "0.68.1",
    "@effect/vitest": "4.1.4",
    "@types/node": "26.6.6",
    "dprint": "0.64.3",
    "effect": "4.1.4",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "playwright-core": "1.65.0",
    "rolldown": "1.3.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.19"
  },
  "publishConfig": {
    "access": "public"
  }
}
