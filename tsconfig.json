{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "include": ["src", "test", "scripts", "vitest.config.ts"],
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "allowJs": false,
    "resolveJsonModule": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.tsbuildinfo",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noErrorTruncation": true,
    "skipLibCheck": true,
    "types": ["node"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedUnstableApis": [
          "@effect/platform-node",
          "@effect/vitest",
          "effect/Stdio",
          "effect/FileSystem",
          "effect/Path",
          "effect/crypto",
          "effect/SemVer",
          "effect/process",
          "effect/socket",
          "effect/encoding",
          "effect/http",
          "effect/cli",
          "effect/testing",
          "effect/Logger#toFile"
        ],
        "diagnosticSeverity": {
          "catchUnfailableEffect": "warning",
          "preferSchemaOverJson": "warning",
          "schemaSync": "warning",
          "strictBooleanExpressions": "warning"
        },
        "overrides": [
          {
            "include": ["test/**/*.ts", "scripts/**/*.ts"],
            "options": {
              "diagnosticSeverity": { "preferSchemaOverJson": "off", "schemaSync": "off" }
            }
          }
        ]
      }
    ]
  }
}
